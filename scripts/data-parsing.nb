       RowBox[{"Transpose", "@", 
        RowBox[{"RandomPoint", "[", 
         RowBox[{
          RowBox[{"Simplex", "[", 
           RowBox[{
            RowBox[{"IdentityMatrix", "[", "n", "]"}], 
            RowBox[{"(", 
             RowBox[{"1", "-", 
              RowBox[{"min", " ", "n"}]}], ")"}]}], "]"}], ",", "n"}], 
         "]"}]}], "+", "min"}], ",", "$Failed"}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
