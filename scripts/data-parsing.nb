Cell["Stationary Probabilities", "Subsection",
 CellChangeTimes->{{3.96752412105534*^9, 3.967524124344183*^9}, {
  3.9675457150807953`*^9, 3.9675457156392403`*^9}, {3.9683454430563984`*^9, 
