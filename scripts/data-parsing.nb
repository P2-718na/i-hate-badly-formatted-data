    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "query", ",", " ", "edgeList", ",", " ", "data", ",", " ", "queryIds", 
        ",", " ", "flowsPositions"}], "}"}], ",", " ", "\[IndentingNewLine]", 
